# Frontend Environment Variables

# API Gateway URL (through Load Balancer)
NEXT_PUBLIC_API_URL=http://localhost:80/api

# Alternative: Direct to API Gateway (for development)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# App Configuration
NEXT_PUBLIC_APP_NAME="Voz Segura"
NEXT_PUBLIC_APP_VERSION="2.0.0"

# Environment
NODE_ENV=production

# Optional: Google OAuth (for future implementation)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret