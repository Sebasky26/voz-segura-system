# API Gateway Environment Variables

# Service Configuration
PORT=8000
NODE_ENV=production

# Microservices URLs
AUTH_SERVICE_URL="http://auth-service:3001"
DENUNCIAS_SERVICE_URL="http://denuncias-service:3002"
LOGS_SERVICE_URL="http://logs-service:3003"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://frontend:3000,http://localhost:8080"

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Proxy Configuration
PROXY_TIMEOUT=30000
PROXY_RETRY_ATTEMPTS=3

# Security
HELMET_ENABLED=true