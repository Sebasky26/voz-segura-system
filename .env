# Voz Segura System 2.0 - Environment Variables

# General
NODE_ENV=development
JWT_SECRET=voz_segura_jwt_secret_super_seguro_cambiar_en_produccion_2024
JWT_EXPIRES_IN=7d

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Auth Service
AUTH_DATABASE_URL=postgresql://vozsegura_auth:auth_password_2024@auth-db:5432/auth_db
AUTH_SERVICE_PORT=3001

# Denuncias Service
DENUNCIAS_DATABASE_URL=postgresql://vozsegura_denuncias:denuncias_password_2024@denuncias-db:5432/denuncias_db
DENUNCIAS_SERVICE_PORT=3002
AUTH_SERVICE_URL=http://auth-service:3001
LOGS_SERVICE_URL=http://logs-service:3003

# Logs Service
LOGS_DATABASE_URL=postgresql://vozsegura_logs:logs_password_2024@logs-db:5432/logs_db
LOGS_SERVICE_PORT=3003

# API Gateway
API_GATEWAY_PORT=8000
CORS_ORIGIN=http://localhost:3000,http://frontend:3000,http://localhost:80

# Load Balancer
NGINX_PORT=80

# Monitoring
PROMETHEUS_PORT=9090
