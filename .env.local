# Variables de entorno para desarrollo local

# Auth Service
AUTH_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_db"
AUTH_JWT_SECRET="tu-secreto-jwt-super-seguro-cambiar-en-produccion"
AUTH_PORT=3001

# Denuncias Service
DENUNCIAS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/denuncias_db"
DENUNCIAS_PORT=3002

# Logs Service
LOGS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logs_db"
LOGS_PORT=3003

# API Gateway
API_GATEWAY_PORT=8000
CORS_ORIGIN="http://localhost:3000"

# URLs de servicios internos
AUTH_SERVICE_URL="http://localhost:3001"
DENUNCIAS_SERVICE_URL="http://localhost:3002"
LOGS_SERVICE_URL="http://localhost:3003"
