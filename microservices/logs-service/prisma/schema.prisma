// Prisma Schema para Logs Service
// Base de datos: logs_db  
// Responsabilidad: Auditoría, configuraciones, métricas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditoriaLog {
  id         String   @id @default(uuid())
  usuarioId  String?  // Usuario ID del auth-service (sin FK)
  accion     String
  recurso    String?
  detalles   String?
  ipAddress  String?
  userAgent  String?
  exitoso    Boolean  @default(true)
  createdAt  DateTime @default(now())
  tabla      String?
  registroId String?
  servicio   String?  // Nuevo: auth-service, denuncias-service, etc.

  @@index([usuarioId])
  @@index([accion])
  @@index([tabla])
  @@index([createdAt])
  @@index([servicio])
  @@map("auditoria_logs")
}

model Configuracion {
  id          String   @id @default(uuid())
  clave       String   @unique
  valor       String
  descripcion String?
  servicio    String?  // Configuración específica de servicio
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clave])
  @@index([servicio])
  @@map("configuraciones")
}

model MetricaNegocio {
  id        String   @id @default(uuid())
  nombre    String
  valor     Float
  unidad    String?  // usuarios, denuncias, requests, etc.
  fecha     DateTime @default(now())
  servicio  String   // auth-service, denuncias-service, etc.
  categoria String?  // business, technical, performance

  @@index([nombre])
  @@index([fecha])
  @@index([servicio])
  @@map("metricas_negocio")
}