# ========================================
# EJEMPLO DE VARIABLES DE ENTORNO
# ========================================
# Este archivo contiene ejemplos de configuración
# NO COMMITEAR ESTE ARCHIVO CON VALORES REALES

# ========================================
# DATABASE - AUTH SERVICE
# ========================================
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGE_ME_auth_secure_password_123
AUTH_DATABASE_URL=postgresql://auth_user:CHANGE_ME_auth_secure_password_123@auth-db:5432/auth_db

# ========================================
# DATABASE - DENUNCIAS SERVICE
# ========================================
DENUNCIAS_DB_NAME=denuncias_db
DENUNCIAS_DB_USER=denuncias_user
DENUNCIAS_DB_PASSWORD=CHANGE_ME_denuncias_secure_password_123
DENUNCIAS_DATABASE_URL=postgresql://denuncias_user:CHANGE_ME_denuncias_secure_password_123@denuncias-db:5432/denuncias_db

# ========================================
# DATABASE - LOGS SERVICE
# ========================================
LOGS_DB_NAME=logs_db
LOGS_DB_USER=logs_user
LOGS_DB_PASSWORD=CHANGE_ME_logs_secure_password_123
LOGS_DATABASE_URL=postgresql://logs_user:CHANGE_ME_logs_secure_password_123@logs-db:5432/logs_db

# ========================================
# AUTHENTICATION
# ========================================
JWT_SECRET=CHANGE_ME_voz_segura_jwt_super_secret_key_2024_please_change_this
JWT_EXPIRES_IN=7d

# ========================================
# FRONTEND
# ========================================
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:80
# Para producción usar la URL real del servidor
# NEXT_PUBLIC_API_GATEWAY_URL=https://api.vozsegura.com

# ========================================
# MONITORING - GRAFANA
# ========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password_123

# ========================================
# DEPLOYMENT SERVER (opcional)
# ========================================
SERVER_HOST=192.168.1.100
SERVER_USER=deployer
# SSH_PRIVATE_KEY se configura como secret en GitHub

# ========================================
# DOCKER REGISTRY
# ========================================
REGISTRY=ghcr.io
IMAGE_PREFIX=sebasky26/voz-segura

# ========================================
# INSTRUCCIONES
# ========================================
# 1. Copiar este archivo como .env.production o .env.staging
# 2. Cambiar todos los valores CHANGE_ME por valores seguros
# 3. Configurar estos valores como secrets en GitHub:
#    - Ir a Settings > Secrets and variables > Actions
#    - Crear environment (staging/production)
#    - Agregar cada variable como secret del environment
# 4. NO commitear archivos .env con valores reales
