@startuml Comparación de Arquitecturas - Voz Segura System

skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title Comparación: Arquitectura Monolítica vs Microservicios\nVoz Segura System

' Lado Izquierdo - Monolítico
rectangle "**ARQUITECTURA MONOLÍTICA**\n(Primer Bimestre)" as mono #FFE4B5 {
    
    rectangle "Next.js Application" as nextapp #FF9F43 {
        rectangle "Frontend\n(React)" as mfrontend #61DAFB
        rectangle "API Routes\n(/api/*)" as mapi #A8E6CF
        rectangle "Services\n(Business Logic)" as mservices #DDA0DD
        rectangle "Prisma ORM" as mprisma #98D8C8
    }
    
    database "PostgreSQL\n(Única BD)" as mdb #95E1D3
    
    mfrontend --> mapi
    mapi --> mservices
    mservices --> mprisma
    mprisma --> mdb
}

' Lado Derecho - Microservicios
rectangle "**ARQUITECTURA MICROSERVICIOS**\n(Segundo Bimestre)" as micro #E8F5E9 {
    
    rectangle "Frontend\nNext.js :3000" as frontend #61DAFB
    
    rectangle "API Gateway\nExpress :8000" as gateway #FF6B6B
    
    rectangle "Microservicios" as services {
        rectangle "Auth\nService\n:3001" as auth #4ECDC4
        rectangle "Denuncias\nService\n:3002" as denuncias #4ECDC4
        rectangle "Logs\nService\n:3003" as logs #4ECDC4
    }
    
    database "auth_db" as authdb #95E1D3
    database "denuncias_db" as denunciasdb #95E1D3
    database "logs_db" as logsdb #95E1D3
    
    frontend --> gateway
    gateway --> auth
    gateway --> denuncias
    gateway --> logs
    auth --> authdb
    denuncias --> denunciasdb
    logs --> logsdb
}

' Tabla Comparativa
rectangle "**COMPARACIÓN**" as comp #F5F5F5 {
    
    rectangle "| Aspecto | Monolítico | Microservicios |\n|---------|------------|----------------|\n| **Deployment** | Un solo deploy | Deploys independientes |\n| **Escalabilidad** | Vertical (toda la app) | Horizontal (por servicio) |\n| **Base de Datos** | Una sola BD | BD por servicio |\n| **Tecnología** | Next.js único | Múltiples servicios Express |\n| **Acoplamiento** | Alto (código compartido) | Bajo (APIs REST) |\n| **Complejidad** | Baja inicial | Alta (orquestación) |\n| **Resiliencia** | Fallo total | Fallo parcial |\n| **Desarrollo** | Un equipo | Equipos independientes |" as tabla #FFFFFF
}

@enduml
