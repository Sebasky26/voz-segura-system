// Prisma Schema para Logs Service
// Base de datos: logs_db  
// Responsabilidad: Auditoría

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditoriaLog {
  id         String   @id @default(uuid())
  usuarioId  String? // Usuario ID del auth-service (sin FK)
  accion     String
  recurso    String?
  detalles   String?
  ipAddress  String?
  userAgent  String?
  exitoso    Boolean  @default(true)
  createdAt  DateTime @default(now())
  tabla      String?
  registroId String?
  servicio   String? // Nuevo: auth-service, denuncias-service, etc.

  @@index([usuarioId])
  @@index([accion])
  @@index([tabla])
  @@index([createdAt])
  @@index([servicio])
  @@map("auditoria_logs")
}
